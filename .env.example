# ==============================================================================
# 服务群风险预警与温度检测 - 生产环境变量配置模板
# 部署使用方法：复制本文件为 .env（cp .env.example .env），填入真实密钥后执行 docker compose up --build -d
# ==============================================================================

# 1. 服务端口与并发配置
BIND_PORT=5001
ANALYZE_MAX_WORKERS=20
MULTI_LABEL=false

# 2. Gemini 模型配置（必填 GEMINI_API_KEY）
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
TEACHER_MODEL=gemini-4-argon

# 3. 飞书自建应用与长连接回调配置
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_feishu_app_secret_here
# 默认接收预警卡片的飞书群 chat_id（若由调用方在每次请求中传 feishu_receive_id 或处于冷启动期，可留空）
FEISHU_DEFAULT_RECEIVE_ID=
# 开启飞书 WebSocket 长连接以接收主管点击卡片审批回调（1=开启，0=关闭）
ENABLE_FEISHU_WS=1

# 4. 飞书多维表格看板配置（留空则默认读取 feishu_card_config.yaml 中的 bitable 配置）
FEISHU_BITABLE_APP_TOKEN=QR7tbtkxkaS8XtsNjI9c3tl6nVf
FEISHU_BITABLE_TABLE_ID=tbl6D1oLTw1pcFct

# 5. PostgreSQL 数据库配置
# 方式 A：直接使用 docker-compose 内置的 postgres 容器（保持以下默认即可，建议生产修改密码）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=znz
PG_PORT=5432
DB_URL=postgresql://postgres:postgres@postgres:5432/znz
# 方式 B：若连接企业现有云数据库（如 RDS PostgreSQL），请直接将上方 DB_URL 替换为真实连接串

# 6. 外网访问代理配置（用于国内服务器访问 Google Gemini API）
# - 海外/香港服务器：保持留空即可直连
# - 国内服务器连接独立代理机：填代理机内网地址，如 http://10.0.1.8:7890
# - 国内服务器代理跑在宿主机本机：填 http://host.docker.internal:7890（勿填 127.0.0.1，且代理需开启允许局域网连接）
HTTP_PROXY=
HTTPS_PROXY=
# 内网数据库与国内飞书域名直连白名单（切勿删除，防止飞书与数据库误走海外代理）
NO_PROXY=localhost,127.0.0.1,postgres,.feishu.cn,.larksuite.com
